doctype html
html
	head
		meta(charset="UTF-8")
		meta(name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover")
		title Random Video - NodeGal
		link(rel="stylesheet" href="/css/video-player.css")
	body
		main.player(data-video-path=videoPath data-playlist-position=playlistPosition data-playlist-size=playlistSize data-file-size=fileSize)
			video#player.video(autoplay playsinline preload="metadata")
				source(src=videoPath)
			img#unsupportedPreview.unsupportedPreview(alt="Video preview")
			a#unsupportedMessage.unsupportedMessage(href="#" role="button" tabindex="0" aria-label="Format not supported. Open in VLC") Format not supported. Click to open in VLC
			div.progressTrack#progressTrack(aria-hidden="true")
				div.progressFill#progressFill
			div.overlay
				div.topBar
					div.topActions
						a.iconButton(href="/" title="Home" aria-label="Home") Home
						input#videoFilter.videoFilter(type="search" value=filterText placeholder="Filter videos" aria-label="Filter videos" autocomplete="on" autocapitalize="off")
						button#tagsToggle.iconButton(type="button" aria-expanded="false" aria-controls="tagsPanel") Tags
						div#tagsPanel.tagsPanel.hidden
							form#tagsForm.tagsForm
								input#tagsInput.tagsInput(type="text" placeholder="Text, to; append" autocomplete="on" autocapitalize="off" aria-label="Tags to append")
								button#tagsApply.tagsApply(type="submit") Append
							div#tagsHistory.tagsHistory(aria-label="Recent tags")
					span#status.status(role="status" aria-live="polite")
				div.centerHint#centerHint(aria-hidden="true")
					span#centerIcon ▶
					span#centerText
				div.bottomControls#bottomControls
					div.videoDetails#videoDetails
						div#pathSearchOptions.pathSearchOptions(aria-label="Search path terms" aria-hidden="true")
						div.videoIdentity
							div#videoFolder.videoFolder(role="button" tabindex="0" title="Click to copy folder")
							div#videoName.videoName(role="button" tabindex="0" title="Click to copy filename")
								span#videoNameText
								span#videoSize.videoSize
						div.videoTimeline
							div#playlistPosition.playlistPosition
							button.timeDisplay#timeDisplay(type="button" title="Switch to remaining time" aria-label="Toggle time display mode") 00:00 / 00:00
					input#seekBar.seekBar(type="range" min="0" max="1000" value="0" step="1" aria-label="Seek")
					div.bottomBar
						div.controls
							button.iconButton#previousButton(type="button" title="Previous video" aria-label="Previous video")
								img.previousIcon(src="/icons/previous.svg" alt="Previous icon")
							button.iconButton#playButton(type="button" title="Play or pause" aria-label="Play or pause")
								img.playIcon(src="/icons/play.svg" alt="Play icon")
							button.iconButton#nextButton(type="button" title="Next random video" aria-label="Next random video")
								img.nextIcon(src="/icons/next.svg" alt="Next icon")
							button.iconButton#resetSearch(type="button" title="Reset video search" aria-label="Reset video search")
								img.resetIcon(src="/icons/reset.svg" alt="Reset icon")
							button.iconButton#shuffleButton.active(type="button" title="Disable shuffle" aria-label="Disable shuffle" aria-pressed="true")
								img.shuffleIcon(src="/icons/shuffle.svg" alt="Shuffle icon")
							button.iconButton#loopButton.active(type="button" title="Disable loop" aria-label="Disable loop" aria-pressed="true")
								img.loopIcon(src="/icons/loop.svg" alt="Loop icon")
							a.iconButton#downloadButton(href=videoPath download title="Download video" aria-label="Download video")
								img.downloadIcon(src="/icons/download.svg" alt="Download icon")
							button.iconButton#fullscreenButton(type="button" title="Enter fullscreen" aria-label="Enter fullscreen")
								img.fullscreenIcon(src="/icons/fullscreen.svg" alt="Fullscreen icon")
							a.iconButton.externalPlayerButton#mxPlayerButton(href="#" title="Open in MX Player" aria-label="Open in MX Player") MX
							a.iconButton.externalPlayerButton#vlcButton(href="#" title="Open in VLC" aria-label="Open in VLC") VLC
		script(src="/js/video-player.js")
