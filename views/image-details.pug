div.infoDiv.marquee-container
	- const searchFolderPath = folderName.replace(/\\/g, '/').replace(/^\/?images(?:\/|$)/, '').replace(/^\/+/, '');
	.marquee.marquee1.gallerySearchLabel(data-gallery-search-label="filename" data-image-name=imageName data-folder-path=searchFolderPath data-copy-text=imageName style = "cursor: copy;")
		|#{imageName}
	.marquee.marquee3.gallerySearchLabel(id = 'subTitle'+idNum data-gallery-search-label="folder" data-image-name=imageName data-folder-path=searchFolderPath data-copy-text=searchFolderPath style = "cursor: copy;")
		|#{searchFolderPath}
	div.gallerySearchOptions(aria-label="Search name and folder terms" aria-hidden="true")
	.marquee.marquee2(onclick = `navigator.clipboard.writeText("${imagePath.substring(imagePath.indexOf('\\',1)).replaceAll('\\', '\\\\')}")` style = "cursor: copy;")
		.subTitle|#{imageResolution} (#{imageSizeReadable})
div.contextMenu.imageDetailsButton
	button.contextMenuButton.sidebarButton(onclick="toggleContextMenu(this)" title = "Context Menu")
		img.contextMenuIcon.actionButtonIcon(src = "/icons/contextMenu.svg")
	.additionalButtons
		a.extraButton.sidebarButton.urlButton(
			href = `${imageLinkEscaped}` target = "_blank"
		)
			img.contextMenuIcon.actionButtonIcon(src = "/icons/url.svg")
		a.extraButton.sidebarButton.androidPlayerIntent(href = `${imageLinkEscaped}` target = "_blank" data-media-path=imageLinkEscaped data-player-package="com.mxtech.videoplayer.pro" title="Open in MX Player" aria-label="Open in MX Player") MX
		a.extraButton.sidebarButton.androidPlayerIntent(href = `${imageLinkEscaped}` target = "_blank" data-media-path=imageLinkEscaped data-player-package="org.videolan.vlc" title="Open in VLC" aria-label="Open in VLC") VLC
div.rename.imageDetailsButton
	button.renameButton.sidebarButton(onclick = 'showRenameDialog(this)')
		img.renameIcon.actionButtonIcon(src = "/icons/rename.svg")
	dialog.renameDialog
		form.renameForm
			input.idNum(type = "text" name = 'idNum'
				value = idNum readonly hidden)
			input.currentFilePath(type = "text" name = 'currentFilePath'
				placeholder = 'Curent File Path' value = imagePath readonly hidden)
			input.newFileName(type = "text" name = 'newFileName'
				value = imageNameNoExt
				placeholder = 'New Name (press Enter)' required)
			input(type="submit" hidden)
div.deleteDiv.imageDetailsButton
	button.deleteButton.sidebarButton(onclick = `deleteFile("${imagePath.replace(/\\/g, "\\\\")}", "${idNum}")` title = "delete")
		img.deleteIcon.actionButtonIcon(src = "/icons/delete.svg")